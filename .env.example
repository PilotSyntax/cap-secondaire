# Optionnel : active la génération Gemini à la demande.
# Ce secret reste exclusivement côté serveur; ne jamais le préfixer par NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Authentification Google côté serveur.
GOOGLE_CLIENT_ID=
# Optionnel : liste d’adresses autorisées, séparées par des virgules.
ALLOWED_USER_EMAILS=
# Optionnel : reçoit la progression familiale historique à la première connexion.
BOOTSTRAP_USER_EMAIL=
